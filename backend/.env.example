# Optional for local uvicorn only. Docker Compose sets RAGLAB_* in docker-compose.yml.
# Process env always wins over this file. Never commit real secrets.
RAGLAB_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/raglab
RAGLAB_DATABASE_ENABLED=true
RAGLAB_UPLOAD_DIR=./data/uploads
RAGLAB_CUSTOM_PLUGIN_DIR=./data/plugins
RAGLAB_CORS_ORIGINS=http://localhost:6650
